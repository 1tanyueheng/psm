# =====================================================================
# PSM Management System
# =====================================================================

# --- Environment & secrets -------------------------------------------
# Never commit real credentials. .env.example documents every key.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# --- PHP / Composer ---------------------------------------------------
/backend/vendor/
/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitignore
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
*.log

# --- Node / frontend --------------------------------------------------
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- Framework runtime ------------------------------------------------
/backend/storage/app/submissions/*
!/backend/storage/app/submissions/.gitignore
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/public/build/
/backend/public/hot
/backend/public/storage

# --- Local overrides --------------------------------------------------
docker-compose.override.yml
*.local

# --- Editors & OS -----------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Build artefacts --------------------------------------------------
/tmp/
/coverage/
*.zip
*.tar.gz

# --- Python tooling ---------------------------------------------------
# docker/wait-for-migrations.py is a supervisord event listener. Compiling it
# leaves a __pycache__ directory next to it, which should not be committed.
__pycache__/
*.py[cod]
