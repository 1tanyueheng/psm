APP_NAME="PSM Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------
# URL of the React SPA (used for CORS + password-reset links)
FRONTEND_URL=http://localhost:5173
# Public leaderboard route is served by the SPA at this path
LEADERBOARD_BASE_PATH=/leaderboard

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Both MySQL and PostgreSQL are supported. The code contains no
# engine-specific SQL, so switching is a configuration change only —
# there is nothing to rewrite in the application.
#
# MySQL (default, and what docker-compose.yml starts):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=psm_system
DB_USERNAME=root
DB_PASSWORD=
#
# PostgreSQL — including Neon, Supabase, and Render Postgres.
# Swap the block above for this one and set DB_SSLMODE=require, because
# hosted providers reject unencrypted connections.
#
# DB_CONNECTION=pgsql
# DB_HOST=your-project.neon.tech
# DB_PORT=5432
# DB_DATABASE=psm_system
# DB_USERNAME=your_user
# DB_PASSWORD=your_password
# DB_SSLMODE=require

# ---------------------------------------------------------------
# Session / Sanctum
# ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_EXPIRATION=null

# ---------------------------------------------------------------
# Cache / Queue  (queue drives Module 6 notifications)
# ---------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=90

# ---------------------------------------------------------------
# File storage (Module 3 submissions, Module 7 archive)
# ---------------------------------------------------------------
FILESYSTEM_DISK=local
SUBMISSION_MAX_MB=25
SUBMISSION_ALLOWED_EXTENSIONS=pdf,doc,docx,zip,txt,md,py,java,js,sql,pptx,xlsx

# ---------------------------------------------------------------
# Mail (Module 6 notifications)
# ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="psm-noreply@example.edu"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Module 6 — Reminder policy
# ---------------------------------------------------------------
# Days before a milestone deadline to send each reminder wave
REMINDER_DAYS_BEFORE=7,3,1
# Hour of day (0-23) that the reminder scan runs
REMINDER_SEND_HOUR=8

# ---------------------------------------------------------------
# Module 4 — Grading policy
# ---------------------------------------------------------------
# How much the final mark blends assessor marks with milestone
# completion, as a percentage. Set to 0 to grade on marks alone.
PSM_MILESTONE_BLEND_PERCENT=20

# ---------------------------------------------------------------
# Module 8 — Leaderboard policy
# ---------------------------------------------------------------
LEADERBOARD_TOP_N=3
LEADERBOARD_MIN_ASSESSORS=2
LEADERBOARD_PUBLISH_DELAY_DAYS=0

# ---------------------------------------------------------------
# Module 1 — Password reset token lifetime (minutes)
# ---------------------------------------------------------------
PASSWORD_RESET_EXPIRE_MINUTES=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"
